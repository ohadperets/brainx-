rules_version = '2';

// BrainX Firestore rules — step 1 (works with the current app, no login needed).
// - Only the three collections the app uses are allowed; everything else is closed.
// - Writes must have the exact shape the app sends (no junk fields, sane sizes).
// - Records can only go UP (nobody can overwrite a record with a lower score) and can't be deleted.
// - Nothing can be deleted from the browser.
// Still open in step 1: anyone can READ users/progress (the admin dashboard reads them from the
// browser). Step 2 (admin "Sign in with Google") closes that.
//
// Apply: Firebase console → Firestore Database → Rules → paste this file → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isStr(v, max) { return v is string && v.size() <= max; }
    function isCount(v) { return v is int && v >= 0 && v <= 10000000; }

    // ---- global high scores: records/{gameId} or records/{gameId}_g3 / _g6 ----
    match /records/{recordId} {
      allow read: if true;

      function validRecord() {
        let d = request.resource.data;
        return recordId.matches('^[a-z0-9-]{1,60}(_g[36])?$')
          && d.keys().hasOnly(['score', 'userName', 'userAvatar', 'userId', 'date', 'grade'])
          // memory scores are 100 − moves, which can dip below 0
          && d.score is number && d.score >= -1000 && d.score <= 100000
          && isStr(d.userName, 40)
          && isStr(d.userAvatar, 16)
          && isStr(d.userId, 80)
          && d.date == request.time
          && (!('grade' in d) || d.grade in [3, 6]);
      }

      allow create: if validRecord();
      allow update: if validRecord() && request.resource.data.score > resource.data.score;
      allow delete: if false;
    }

    // ---- one document per child per device: users/{deviceId}_{userId} ----
    match /users/{docId} {
      allow read: if true;   // admin dashboard (closed in step 2)

      function validUser(d) {
        return isStr(d.name, 40)
          && isStr(d.avatar, 16)
          && d.grade in [2, 3, 5, 6]
          && isStr(d.userId, 80)
          && isStr(d.deviceId, 80);
      }
      allow create: if docId.size() <= 170
        && request.resource.data.keys().hasOnly(['userId', 'name', 'avatar', 'grade', 'deviceId', 'lastSeen', 'createdAt'])
        && validUser(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userId', 'name', 'avatar', 'grade', 'deviceId', 'lastSeen', 'createdAt'])
        && validUser(request.resource.data);
      allow delete: if false;
    }

    // ---- progress summary per child per device: progress/{deviceId}_{userId} ----
    match /progress/{docId} {
      allow read: if true;   // admin dashboard (closed in step 2)

      function validProgress(d) {
        return isStr(d.userId, 80)
          && isStr(d.userName, 40)
          && isStr(d.deviceId, 80)
          && isCount(d.stars)
          && isCount(d.streak)
          && isCount(d.gamesPlayed)
          && d.achievements is list && d.achievements.size() <= 200
          && d.quizAttempts is map;
      }
      allow create: if docId.size() <= 170
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'deviceId', 'stars', 'streak', 'achievements', 'gamesPlayed', 'quizAttempts', 'lastUpdated'])
        && validProgress(request.resource.data);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['userId', 'userName', 'deviceId', 'stars', 'streak', 'achievements', 'gamesPlayed', 'quizAttempts', 'lastUpdated'])
        && validProgress(request.resource.data);
      allow delete: if false;
    }

    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
